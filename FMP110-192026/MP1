import java.util.Scanner;

class InvalidGradeException extends Exception {
    public InvalidGradeException(String message) {
        super(message);
    }
}

class Student {
    private String name;
    private double grade;

    public Student(String name, double grade) {
        this.name = name;
        this.grade = grade;
    }

    public String getName() {
        return name;
    }

    public double getGrade() {
        return grade;
    }

    @Override
    public String toString() {
        return name + ": " + grade;
    }
}

public class MP1 {
    private static Student[] roster = new Student[5];
    private static int studentCount = 0;

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        boolean running = true;

        while (running) {
            System.out.println("\nMenu: 1 Add | 2 List | 3 Lookup | 0 Exit");
            System.out.print("Select an option: ");
            String choice = scanner.nextLine().trim();

            try {
                switch (choice) {
                    case "1":
                        if (studentCount >= roster.length) {
                            throw new ArrayIndexOutOfBoundsException("Grade book is full.");
                        }

                        System.out.print("Enter name: ");
                        String name = scanner.nextLine().trim();
                        if (name.isEmpty()) {
                            throw new IllegalArgumentException("Name cannot be blank.");
                        }

                        System.out.print("Enter grade: ");
                        String gradeStr = scanner.nextLine().trim();
                        double grade = Double.parseDouble(gradeStr);
                        
                        if (Double.isNaN(grade) || Double.isInfinite(grade)) {
                            throw new NumberFormatException();
                        }

                        validateGrade(grade);
                        
                        roster[studentCount] = new Student(name, grade);
                        studentCount++;
                        System.out.println("Added " + name + ": " + grade);
                        break;

                    case "2":
                        for (int i = 0; i < studentCount; i++) {
                            System.out.println("[" + i + "] " + roster[i].toString());
                        }
                        if (studentCount == 0) System.out.println("No records found.");
                        break;

                    case "3":
                        System.out.print("Enter index to lookup: ");
                        int index = Integer.parseInt(scanner.nextLine().trim());
                        if (index < 0 || index >= studentCount) {
                            throw new ArrayIndexOutOfBoundsException("Index is outside the stored records.");
                        }
                        System.out.println("Found: " + roster[index].toString());
                        break;

                    case "0":
                        running = false;
                        System.out.println("Exiting system.");
                        break;

                    default:
                        System.out.println("Error: Invalid option.");
                }
            } catch (InvalidGradeException e) {
                System.out.println("Error: " + e.getMessage());
            } catch (NumberFormatException e) {
                System.out.println("Error: Enter a valid number.");
            } catch (ArrayIndexOutOfBoundsException e) {
                System.out.println("Error: " + e.getMessage());
            } catch (IllegalArgumentException e) {
                System.out.println("Error: " + e.getMessage());
            }
        }
        scanner.close();
    }

    private static void validateGrade(double grade) throws InvalidGradeException {
        if (grade < 0 || grade > 100) {
            throw new InvalidGradeException("Grade must be between 0 and 100.");
        }
    }
}
