import java.util.Scanner;

class LibraryException extends Exception {
    public LibraryException(String msg) { super(msg); }
}

class Book {
    private int id, available, borrowed;
    private String title;

    public Book(int id, String title, int available) {
        this.id = id; 
        this.title = title; 
        this.available = available; 
        this.borrowed = 0;
    }
    
    public int getId() { return id; }
    public int getTotalCopies() { return available + borrowed; }

    public void borrow() throws LibraryException {
        if (available <= 0) throw new LibraryException("No copies available.");
        available--; borrowed++;
    }

    public void returnCopy() throws LibraryException {
        if (borrowed <= 0) throw new LibraryException("No borrowed copies to return.");
        available++; borrowed--;
    }

    @Override 
    public String toString() {
        return "Available " + available + ", borrowed " + borrowed;
    }
}

public class MP5 {
    private static Book[] library = {
        new Book(1, "Java Basics", 2),
        new Book(2, "Algorithms", 1),
        new Book(3, "Databases", 0)
    };

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        
        while (true) {
            System.out.print("\nMenu: 1 Borrow | 2 Return | 3 Find | 4 List | 0 Exit\nSelect: ");
            String choice = sc.nextLine().trim();
            if (choice.equals("0")) break;

            int initialTotal = getTotalCopiesAcrossLibrary();

            try {
                if (choice.equals("4")) {
                    for (Book b : library) System.out.println("ID " + b.getId() + " | " + b);
                    continue;
                }

                System.out.print("Book ID: ");
                Book b = findBook(Integer.parseInt(sc.nextLine().trim()));

                switch (choice) {
                    case "1": b.borrow(); System.out.println(b); break;
                    case "2": b.returnCopy(); System.out.println(b); break;
                    case "3": System.out.println(b); break;
                    default: System.out.println("Error: Invalid option.");
                }
            } catch (LibraryException | IllegalArgumentException e) {
                System.out.println("Error: " + e.getMessage());
            } catch (NumberFormatException e) {
                System.out.println("Error: Enter a valid number.");
            } finally {
                // Invariant validation: Total items must remain identical after every transaction attempt
                if (initialTotal != getTotalCopiesAcrossLibrary()) {
                    System.out.println("CRITICAL ERROR: Copies lost or duplicated!");
                }
            }
        }
    }

    private static Book findBook(int id) {
        for (Book b : library) {
            if (b.getId() == id) return b;
        }
        throw new IllegalArgumentException("Book not found.");
    }

    private static int getTotalCopiesAcrossLibrary() {
        int sum = 0;
        for (Book b : library) sum += b.getTotalCopies();
        return sum;
    }
}
